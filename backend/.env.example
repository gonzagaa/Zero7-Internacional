# Meta Conversions API — variaveis de ambiente
# Copie este arquivo como .env (local) ou cadastre na aba
# "Environment Variables" do projeto na Vercel. NUNCA versione .env real.

# ID do Pixel Meta (numerico)
META_PIXEL_ID=

# System User Access Token com permissao de Conversions API (Events Manager > Configuracoes > Conversions API)
META_ACCESS_TOKEN=

# OPCIONAL: codigo de teste do Events Manager (aba "Test Events").
# Deixe VAZIO em producao — se preenchido, os eventos vao para o painel de teste
# e nao contam como conversoes reais.
META_TEST_EVENT_CODE=

# Lista de origens permitidas (CORS), separadas por virgula. Sem espacos.
# Exemplo: https://zero7trading.com,https://www.zero7trading.com,http://localhost:5500
ALLOWED_ORIGINS=
